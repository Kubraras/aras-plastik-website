# Supabase Dashboard > Project Connect / Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: this key bypasses RLS. Never expose it to the browser or use a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
# Legacy fallbacks supported while migrating existing projects:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Canonical production origin, without a trailing slash (e.g. https://example.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email provider: replies require a verified sender domain in Resend.
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
RESEND_FROM_EMAIL=
